{
  "name": "@louisraetz/steamidled",
  "version": "1.2.0",
  "description": "Steam game idler CLI and daemon - idle games and accumulate playtime",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "steamidled": "dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && vite build --config web/vite.config.ts",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "steam",
    "idler",
    "daemon",
    "game-time",
    "playtime",
    "cli",
    "trading-cards"
  ],
  "author": "louisraetz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louisraetz/steamidled.git"
  },
  "homepage": "https://github.com/louisraetz/steamidled#readme",
  "bugs": {
    "url": "https://github.com/louisraetz/steamidled/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@inquirer/prompts": "^8.2.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "hono": "^4.13.14",
    "ora": "^9.3.0",
    "qrcode-terminal": "^0.12.0",
    "steam-session": "^1.9.4",
    "steam-user": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^25.2.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.66.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wouter": "^3.13.0",
    "zustand": "^5.0.16"
  }
}
